{
  "name": "tor-landa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "knip": "knip",
    "depcheck": "depcruise src --config .dependency-cruiser.mjs --output-type text",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm knip && pnpm depcheck && pnpm build",
    "test:telegram": "node -r dotenv/config scripts/test-telegram.js dotenv_config_path=.env.local"
  },
  "dependencies": {
    "@notionhq/client": "^5.27.1",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "^18.6.0",
    "knip": "^6.42.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4",
    "typescript": "^7"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
